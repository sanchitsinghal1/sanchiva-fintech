# Sanchiva backend env template — copy to `.env` and fill HUMAN ACTION values.
PORT=5000
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# HUMAN ACTION REQUIRED (production): paste your MongoDB Atlas connection string.
# Leave EMPTY in dev to auto-start an in-memory MongoDB (zero-config preview).
MONGODB_URI=

# HUMAN ACTION REQUIRED: generate two long random strings:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_your_access_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_your_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# HUMAN ACTION REQUIRED: https://dashboard.stripe.com → Developers → API keys (sk_test_...)
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_test_secret_key

# HUMAN ACTION REQUIRED: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_replace_with_your_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_key_secret
