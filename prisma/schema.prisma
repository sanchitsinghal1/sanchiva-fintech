// ============================================================================
// SANCHIVA — Next-Gen Fintech & Banking Platform
// Prisma Schema (SQLite datasource)
// ----------------------------------------------------------------------------
// NOTE ON STACK ADAPTATION:
// The original brief requested MongoDB + Mongoose. This sandbox ships with a
// Prisma + SQLite datasource (see .env DATABASE_URL). Prisma gives us
// type-safe models, ACID $transaction sessions (for safe money transfers),
// and migrations out of the box — the same enterprise guarantees we'd get
// from MongoDB+Mongoose, but without requiring an external Mongo instance.
// All money fields are Float for demo simplicity; in production swap to
// Decimal(scale: 2) once on PostgreSQL.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// USER — the bank customer. Owns accounts, cards, beneficiaries, requests.
// KYC flow: PENDING -> VERIFIED (or REJECTED). Only VERIFIED users can move
// money. Password is stored as a bcrypt hash — never plaintext.
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String
  dob          String?
  kycStatus    String   @default("PENDING") // PENDING | VERIFIED | REJECTED
  kycDocument  String?
  avatarColor  String   @default("emerald") // gradient key for avatar
  address      String?
  city         String?
  country      String?
  occupation    String?
  incomeRange  String?
  role         String   @default("USER") // USER | ADMIN
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts      Account[]
  cards         Card[]
  beneficiaries Beneficiary[]
  requestsSent     Request[]      @relation("RequestFromUser")
  requestsReceived Request[]     @relation("RequestToUser")
  notifications Notification[]
  refreshTokens RefreshToken[]
}

// ---------------------------------------------------------------------------
// ACCOUNT — a wallet/bank account owned by a user. Each user gets a primary
// account on registration. accountNumber is a unique, human-readable id.
// SQLite has no native Decimal; Float is fine for the demo ledger.
// ---------------------------------------------------------------------------
model Account {
  id            String   @id @default(cuid())
  userId        String
  accountNumber String   @unique // 10-digit human-readable id
  type          String   @default("SAVINGS") // SAVINGS | CURRENT | WALLET
  balance       Float    @default(0)
  currency      String   @default("INR")
  status        String   @default("ACTIVE") // ACTIVE | DORMANT | CLOSED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards        Card[]
  txOut        Transaction[] @relation("TxFromAccount")
  txIn         Transaction[] @relation("TxToAccount")

  @@index([userId])
}

// ---------------------------------------------------------------------------
// TRANSACTION — immutable ledger entry. Money flows from -> to.
//   type:     TRANSFER | DEPOSIT | WITHDRAWAL | PAYMENT | REQUEST | SPLIT
//   status:   PENDING | COMPLETED | FAILED
//   category: FOOD | TRAVEL | BILLS | SHOPPING | INCOME | TRANSFER | OTHER
// fromAccountId/toAccountId are nullable to model deposits (no source) and
// withdrawals (no destination) — i.e. external cash movements.
// ---------------------------------------------------------------------------
model Transaction {
  id             String   @id @default(cuid())
  fromAccountId  String?
  toAccountId    String?
  fromUserId     String?  // denormalised for fast "my transactions" queries
  toUserId       String?
  amount         Float
  type           String   @default("TRANSFER")
  status         String   @default("COMPLETED")
  category       String   @default("TRANSFER")
  description    String
  reference      String   @default(cuid()) // human-readable txn ref
  createdAt      DateTime @default(now())

  fromAccount Account? @relation("TxFromAccount", fields: [fromAccountId], references: [id], onDelete: SetNull)
  toAccount   Account? @relation("TxToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)

  @@index([fromUserId])
  @@index([toUserId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// CARD — virtual (and physical) payment cards. cvvHash is hashed at rest;
// full CVV is only ever shown transiently in the UI. status can be frozen by
// the user instantly. dailyLimit/monthlyLimit cap contactless spend.
// ---------------------------------------------------------------------------
model Card {
  id            String   @id @default(cuid())
  userId        String
  accountId     String
  cardNumber    String   @unique // 16-digit PAN (stored as-is for demo)
  cardHolder    String
  expiryMonth   String   // "MM"
  expiryYear    String   // "YY"
  cvvHash       String   // bcrypt-style hash of the 3-digit CVV
  network       String   @default("VISA") // VISA | MASTERCARD | AMEX
  type          String   @default("VIRTUAL") // VIRTUAL | PHYSICAL | CREDIT
  status        String   @default("ACTIVE") // ACTIVE | FROZEN | BLOCKED
  dailyLimit    Float    @default(50000)
  monthlyLimit  Float    @default(200000)
  color         String   @default("emerald") // card face gradient key
  spentToday    Float    @default(0)
  spentThisMonth Float  @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// BENEFICIARY — saved payee. Users send money to beneficiaries by nickname.
// ---------------------------------------------------------------------------
model Beneficiary {
  id            String   @id @default(cuid())
  userId        String
  name          String
  accountNumber String
  bankName      String   @default("Sanchiva Bank")
  ifsc          String   @default("SANC0001")
  nickname      String
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// REQUEST — money requests + split bills. splitMembers is a JSON string of
// {userId, name, share} entries (SQLite has no array type). status flows
// PENDING -> ACCEPTED -> PAID (or REJECTED).
// ---------------------------------------------------------------------------
model Request {
  id            String   @id @default(cuid())
  fromUserId    String
  toUserId      String
  amount        Float
  description    String
  type          String   @default("REQUEST") // REQUEST | SPLIT
  splitMembers  String?  // JSON string for SPLIT type
  totalAmount   Float    @default(0) // for SPLIT: the full bill before splitting
  status        String   @default("PENDING") // PENDING | ACCEPTED | REJECTED | PAID
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  fromUser User @relation("RequestFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("RequestToUser", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([fromUserId])
  @@index([toUserId])
}

// ---------------------------------------------------------------------------
// NOTIFICATION — in-app notification feed. type drives the icon + colour.
// ---------------------------------------------------------------------------
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("SYSTEM") // TRANSACTION | REQUEST | SYSTEM | SECURITY
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// REFRESH TOKEN — long-lived rotation token for the JWT auth architecture.
// Each login issues an access token (15m) + a refresh token (7d, stored here).
// On refresh, the old token is revoked and a new pair is issued (rotation).
// ---------------------------------------------------------------------------
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
