# Sanchiva frontend env (Next.js public vars must be NEXT_PUBLIC_*).
# The API base is the gateway on :81 — fetches use relative paths with
# ?XTransformPort=5000 so Caddy routes them to the Express backend.

# HUMAN ACTION REQUIRED (optional, for real Stripe card elements):
# https://dashboard.stripe.com → Developers → API keys → pk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_stripe_publishable_key
NEXT_PUBLIC_APP_URL=http://localhost:3000
