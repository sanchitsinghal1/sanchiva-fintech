# Sanchiva runtime env — values below are intentionally left as dev defaults.
# In production, replace secrets marked HUMAN ACTION REQUIRED in .env.example.

DATABASE_URL="file:/home/z/my-project/db/custom.db"

# Dev-only secrets (rotate before any production deploy)
JWT_ACCESS_SECRET="sanchiva_dev_access_secret_change_me_in_production_32chars"
JWT_REFRESH_SECRET="sanchiva_dev_refresh_secret_change_me_in_production_32chars"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe test mode — replace with your own test keys to actually charge cards.
STRIPE_SECRET_KEY="sk_test_sanchiva_dev_placeholder"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_sanchiva_dev_placeholder"

REALTIME_PORT="3003"
